============================== echo of input deck ==============================
echo
start job
permanent_dir .
scratch_dir /home/user/hfauto_scratch/nwchem/b7629843069dc87d_attempt_00
memory total 1200 mb

geometry units angstrom nocenter noautosym
  F   0.0000000000  0.0000000000 -1.1500000000
  H   0.0000000000  0.0000000000  0.0300000000
  F   0.0000000000  0.0000000000  1.1500000000
end
charge -1
basis spherical
  * library def2-svpd
end

dft
  xc pbe0
  mult 1
  grid fine
  convergence energy 1.0e-07
  disp vdw 4
end

driver
  maxiter 100
  trust 0.1
  xyz final
end

task dft optimize
