============================== echo of input deck ==============================
echo
start job
permanent_dir .
scratch_dir /home/user/hfauto_scratch/nwchem/91cb2122dee7b4b2_attempt_00
memory total 1200 mb

geometry units angstrom nocenter noautosym
  O   0.0000000000  0.0000000000  0.0000000000
  H   0.0000000000  0.0000000000  0.9900000000
end
charge 0
basis spherical
  * library def2-svpd
end

dft
  xc pbe0
  mult 2
  odft
  grid fine
  convergence energy 1.0e-07
  disp vdw 4
end

driver
  maxiter 100
  trust 0.1
  xyz final
end

task dft optimize
