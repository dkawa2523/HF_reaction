memory total 1200 mb

geometry units angstrom nocenter noautosym
  O   0.0000000000  0.0000000000  0.0077771700
  H   0.0000000000  0.0000000000  0.9822228300
end
charge 0
basis spherical
  * library def2-svpd
end

dft
  xc pbe0
  mult 2
  odft
  grid fine
  convergence energy 1.0e-07
  disp vdw 4
end

