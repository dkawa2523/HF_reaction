start job
permanent_dir .
scratch_dir /home/user/hfauto_scratch/nwchem/30da9ef8b1804d46_attempt_00
memory total 1200 mb

geometry units angstrom nocenter noautosym
  Cl  0.0000000000  0.0000000000  0.0000000000
end
charge -1
basis spherical
  * library def2-svpd
end

dft
  xc pbe0
  mult 1
  grid fine
  convergence energy 1.0e-07
  disp vdw 4
end

